# ---- LLM 网关（OpenAI 兼容即可）----
# 本地开发：指向本机 new-api 统一网关，可用模型多、便于跑 Race Mode
# 线上部署：换成任意 OpenAI 兼容端点（智谱 / DeepSeek / OpenAI / Anthropic 兼容层）
LLM_BASE_URL=http://127.0.0.1:3000/v1
LLM_API_KEY=local
LLM_MODEL=glm-5.2

# Race Mode 的并跑模型池，逗号分隔
LLM_RACE_MODELS=glm-5.2,deepseek-v4-pro,gpt-4.1

# ---- 持久化 ----
# 不设置 => 使用本地 .data/ 目录的文件存储，零依赖，克隆下来直接能跑
# 设置为 Postgres 连接串（如 Neon）=> 自动建表并使用数据库，适配 Vercel 等无状态部署
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
