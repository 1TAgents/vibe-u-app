# ---- LLM 网关（OpenAI 兼容即可）----
# 默认示例与线上 Demo 保持一致；也可以替换为其他 OpenAI-compatible 端点与模型。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# 首页可选模型，逗号分隔；只有一个可用模型时保持单项即可。
LLM_RACE_MODELS=deepseek-v4-flash

# ---- 持久化 ----
# 不设置 => 使用本地 .data/ 目录的文件存储，零依赖，克隆下来直接能跑
# 设置为 Postgres 连接串（如 Neon）=> 自动建表并使用数据库，适配 Vercel 等无状态部署
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
